---
interface Props {
  diagonal?: boolean;
}
const { diagonal = false } = Astro.props;
---

<svg viewBox="0 0 24 24" fill="none" aria-hidden="true" class="arrow">
  {
    diagonal ? (
      <path d="M6 18 18 6M6 6h12v12" stroke="currentColor" stroke-width="1.5" />
    ) : (
      <path d="M4 12h15m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.5" />
    )
  }
</svg>
