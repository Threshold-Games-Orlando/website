---
import Layout from '../layouts/Layout.astro';
import Mark from '../components/Mark.astro';
import Arrow from '../components/Arrow.astro';
import { site } from '../lib/content';
---

<Layout>
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="header wrap">
    <a href="/" class="brand" aria-label={site.name + ' home'}>
      <Mark /><span>{site.name}<small>Trading cards & tabletop</small></span>
    </a>
    <nav aria-label="Main navigation">
      <a href="#about">Our story</a>
      <a href="#connect">Connect</a>
      <a class="nav-shop" href={site.shopUrl}>Visit our shop <Arrow diagonal /></a>
    </nav>
  </header>
  <main id="main">
    <section class="hero wrap" aria-labelledby="hero-heading">
      <div class="hero-copy">
        <p class="eyebrow"><span class="tiny-diamond"></span>{site.eyebrow}</p>
        <h1 id="hero-heading">{site.heroTitle}<em>{site.heroAccent}</em></h1>
        <p class="hero-description">{site.heroBody}</p>
        <a class="button primary" href={site.shopUrl}>{site.shopLabel}<Arrow diagonal /></a>
        <p class="shop-note">
          <span class="status-dot"></span>Our online shop is open on TCGplayer
        </p>
      </div>
      <div class="portal-scene" aria-hidden="true">
        <div class="orbital orbital-one"></div><div class="orbital orbital-two"></div>
        <span class="star star-one">✦</span><span class="star star-two">✧</span><span
          class="star star-three">✦</span
        >
        <div class="portal-aura"></div>
        <div class="portal">
          <div class="portal-inner">
            <div class="horizon"></div><span class="light-line"></span>
          </div>
        </div>
        <svg class="crystal" viewBox="0 0 110 190" fill="none">
          <defs
            ><linearGradient
              id="crystal-fill"
              x1="0"
              y1="0"
              x2="110"
              y2="190"
              gradientUnits="userSpaceOnUse"
              ><stop stop-color="#bedaff" stop-opacity=".65"></stop><stop
                offset=".45"
                stop-color="#7088f0"
                stop-opacity=".15"></stop><stop offset="1" stop-color="#9bb6ff" stop-opacity=".4"
              ></stop></linearGradient
            ></defs
          >
          <path
            d="m55 5 39 62-9 58-30 60-30-60-9-58L55 5Z"
            fill="url(#crystal-fill)"
            stroke="#bfd2ff"
            stroke-width="1"></path>
          <path
            d="m55 5-9 67 9 113 13-113L55 5ZM16 67l30 5 22 0 26-5M25 125l30-23 30 23M46 72l9 30 13-30"
            stroke="#bed4ff"
            stroke-opacity=".6"></path>
        </svg>
        <div class="portal-floor"></div>
        <p class="scene-caption"><span>01</span> A new adventure awaits <span>✧</span></p>
      </div>
      <a class="scroll-cue" href="#about"><span></span>Step inside</a>
    </section>
    <div class="chapter-line wrap" aria-hidden="true">
      <span>Trading cards</span><span class="diamond">✧</span><span>Tabletop worlds</span><span
        class="diamond">✧</span
      ><span>Shared adventures</span>
    </div>
    <section class="about wrap section" id="about" aria-labelledby="about-heading">
      <div class="section-intro">
        <p class="eyebrow"><span class="section-number">01 /</span>{site.aboutLabel}</p>
        <div class="intro-columns">
          <h2 id="about-heading">{site.aboutTitle}</h2><p>{site.aboutBody}</p>
        </div>
      </div>
      <div class="values">
        {
          site.values.map((value, i) => (
            <article class="value">
              <>
                <span class="value-number">
                  0{i + 1}
                  <span>✧</span>
                </span>
                <h3>{value.title}</h3>
                <p>{value.body}</p>
              </>
            </article>
          ))
        }
      </div>
    </section>
    <section class="shop-section wrap" aria-labelledby="shop-heading">
      <div class="shop-panel">
        <div class="shop-emblem" aria-hidden="true"><Mark /></div>
        <div class="shop-copy">
          <p class="eyebrow">The collection begins</p><h2 id="shop-heading">
            {site.shopHeading}
          </h2><p>{site.shopBody}</p>
        </div>
        <a class="button primary" href={site.shopUrl}>Shop on TCGplayer<Arrow diagonal /></a>
      </div>
    </section>
    <section class="connect wrap section" id="connect" aria-labelledby="connect-heading">
      <div>
        <p class="eyebrow"><span class="section-number">02 /</span>Stay in the loop</p>
        <h2 id="connect-heading">{site.contactTitle}</h2>
      </div>
      <div class="connect-content">
        <p>{site.contactBody}</p>
        {
          site.contactEmail && (
            <a class="text-link" href={'mailto:' + site.contactEmail}>
              {site.contactEmail}
              <Arrow diagonal />
            </a>
          )
        }
        {
          site.socials.length > 0 ? (
            <ul class="socials" aria-label="Social accounts">
              {site.socials.map((social) => (
                <li>
                  <a href={social.url}>
                    {social.label}
                    <Arrow diagonal />
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            <p class="coming-soon">
              <span class="tiny-diamond" />
              Community channels coming soon
            </p>
          )
        }
        {
          site.contactFormEnabled && (
            <form
              name="contact"
              method="POST"
              action="/thank-you/"
              data-netlify="true"
              netlify-honeypot="bot-field"
            >
              <input type="hidden" name="form-name" value="contact" />
              <p hidden>
                <label>
                  Leave this empty <input name="bot-field" tabindex="-1" autocomplete="off" />
                </label>
              </p>
              <div class="form-row">
                <>
                  <label>
                    Your name
                    <input name="name" autocomplete="name" required maxlength="120" />
                  </label>
                  <label>
                    Email address
                    <input
                      name="email"
                      type="email"
                      autocomplete="email"
                      required
                      maxlength="254"
                    />
                  </label>
                </>
              </div>
              <label>
                Your message
                <textarea name="message" rows="4" required maxlength="5000" />
              </label>
              <p class="form-note">We'll use the details you provide to respond to your message.</p>
              <button class="button primary" type="submit">
                Send message
                <Arrow />
              </button>
            </form>
          )
        }
      </div>
    </section>
  </main>
  <footer class="footer wrap">
    <a href="/" class="footer-brand"><Mark />{site.name}</a>
    <p>{site.footerNote}</p>
    <small>© {new Date().getFullYear()} {site.name} · Orlando, FL</small>
  </footer>
</Layout>
